# Application config
APP_NAME=legacy-rp-admin-v3
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DISCORD_OAUTH_ID=discord_client_id
DISCORD_OAUTH_SECRET=discord_client_secret

# Database connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legacy-rp-admin-v3
DB_USERNAME=root
DB_PASSWORD=password

# Discord lookup
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1234

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

VUE_APP_LOCALE=en-us

# OP-FW configuration
OP_FW_SERVERS=c3s1.op-framework.com;c3s1,127.0.0.1:30120
OP_FW_TOKEN=mytoken
DEV_API_KEY=some_random_token

ALLOW_ROLE_EDITING=false

HIDE_BAN_CREATOR=false

# Panel permissions (default role requirements)
# Accepted values: staff, senior, superadmin, root, disabled
P_SCREENSHOT=staff
P_SCREENSHOT_SHELL=senior
P_SUSPICIOUS=senior
P_ADVANCED=senior
P_LIVEMAP=staff
P_LOCK_BAN=senior
P_EDIT_TAG=root
P_LOADING_SCREEN=superadmin
P_VIEW_QUEUE=senior
P_Y_DELETE=superadmin
P_Y_VERIFY=superadmin
P_Y_EDIT=superadmin
P_LINKED=root
P_LINKED_VALUES=root
P_ANNOUNCEMENT=superadmin
P_DAMAGE_LOGS=senior
P_EXPLOSION_EVENTS=staff
P_CRAFTING=superadmin
P_PHONE_LOGS=superadmin
P_MONEY_LOGS=staff
P_ANTI_CHEAT=staff
P_DARK_CHAT=senior
P_BAN_EXCEPTION=superadmin
P_WHITELIST=superadmin
P_API_TOKENS=superadmin
P_REALTY_EDIT=superadmin
P_REALTY_VIEW=senior
P_SAVINGS_LOGS=senior
P_BULK_DELETE=root
P_VIEW_INVENTORY=superadmin
P_EDIT_INVENTORY=superadmin
P_DIVORCE_CHARACTERS=superadmin
P_REVIVE_OFFLINE=superadmin
P_MANAGE_VEHICLES=superadmin
P_EDIT_PED_MODEL=superadmin
P_RESET_VEHICLE_GARAGE=superadmin
P_SUSPICIOUS_ENTITIES=senior
P_EDIT_COMPANY_BALANCE=superadmin
P_EDIT_SAVINGS_BALANCE=superadmin
P_VIEW_AUDIT_LOGS=senior
P_CONTAINER_ACCESS=senior
P_HIDDEN_NOTES=senior
P_RESTRICTED_LOGS=senior
P_USER_VARIABLES=senior
P_BLACKLIST=superadmin
P_DELETE_CHARACTERS=superadmin
P_EDIT_CHARACTER_BALANCE=superadmin
P_DIAGNOSTICS=root
